Option Explicit

'===============================================================================
' MODULE: DataUpdate
' PURPOSE:
'   Apply only the rows marked Select = YES on the Changes sheet to Sheet1.
'
' RULES:
'   Modified -> find the existing record by REQUEST + NUMBER and replace the
'               complete record with the values from the selected Changes row.
'   Added    -> append the selected record to the end of Sheet1.
'   Deleted  -> find the existing record by REQUEST + NUMBER and delete it.
'
' Changes sheet:
'   A = Select
'   B = Change Type
'   C onward = data columns
'   last 3 columns = Changed By / Time / Date (ignored)
'
' Sheet1:
'   header row = 2
'===============================================================================

Private Const CHANGES_SHEET_NAME As String = "Changes"
Private Const TARGET_SHEET_INDEX As Long = 1
Private Const TARGET_HEADER_ROW As Long = 2
Private Const CHANGES_HEADER_ROW As Long = 1

Private Const SELECT_COL As Long = 1
Private Const TYPE_COL As Long = 2
Private Const DATA_START_COL As Long = 3

Private Const KEY_REQUEST As String = "REQUEST"
Private Const KEY_NUMBER As String = "NUMBER"

Public Sub Copy_Drawing_List()

    Dim wb As Workbook
    Dim wsTarget As Worksheet
    Dim wsChanges As Worksheet

    Dim targetReqCol As Long, targetNumCol As Long
    Dim changesReqCol As Long, changesNumCol As Long
    Dim lastChangeRow As Long
    Dim lastChangeCol As Long

    Dim targetHeaders As Object
    Dim changesHeaders As Object

    Dim r As Long
    Dim targetRow As Long
    Dim action As String
    Dim selectValue As String
    Dim req As Variant
    Dim num As Variant

    Dim selectedCount As Long
    Dim modifiedCount As Long
    Dim addedCount As Long
    Dim deletedCount As Long
    Dim skippedCount As Long
    Dim errorCount As Long

    Dim oldScreen As Boolean
    Dim oldEvents As Boolean
    Dim oldAlerts As Boolean
    Dim oldCalc As XlCalculation

    On Error GoTo Fail

    Set wb = ThisWorkbook
    Set wsTarget = wb.Worksheets(TARGET_SHEET_INDEX)
    Set wsChanges = wb.Worksheets(CHANGES_SHEET_NAME)

    oldScreen = Application.ScreenUpdating
    oldEvents = Application.EnableEvents
    oldAlerts = Application.DisplayAlerts
    oldCalc = Application.Calculation

    If MsgBox( _
        "Apply ONLY Changes rows where Select = YES?" & vbCrLf & vbCrLf & _
        "Modified = replace the matching Sheet1 record" & vbCrLf & _
        "Added    = append the record to Sheet1" & vbCrLf & _
        "Deleted  = delete the matching Sheet1 record", _
        vbOKCancel + vbQuestion, "DataUpdate") <> vbOK Then Exit Sub

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.DisplayAlerts = False
    Application.Calculation = xlCalculationManual

    '---------------------------------------------------------------------------
    ' Build header maps.
    ' Sheet1 headers are on row 2.
    ' Changes headers are on row 1.
    '---------------------------------------------------------------------------
    Set targetHeaders = BuildHeaderMap(wsTarget, TARGET_HEADER_ROW)
    Set changesHeaders = BuildHeaderMap(wsChanges, CHANGES_HEADER_ROW)

    If Not targetHeaders.Exists(UCase$(KEY_REQUEST)) Then _
        Err.Raise vbObjectError + 100, , "REQUEST header was not found in Sheet1."

    If Not targetHeaders.Exists(UCase$(KEY_NUMBER)) Then _
        Err.Raise vbObjectError + 101, , "NUMBER header was not found in Sheet1."

    If Not changesHeaders.Exists(UCase$(KEY_REQUEST)) Then _
        Err.Raise vbObjectError + 102, , "REQUEST header was not found in Changes."

    If Not changesHeaders.Exists(UCase$(KEY_NUMBER)) Then _
        Err.Raise vbObjectError + 103, , "NUMBER header was not found in Changes."

    targetReqCol = targetHeaders(UCase$(KEY_REQUEST))
    targetNumCol = targetHeaders(UCase$(KEY_NUMBER))

    changesReqCol = changesHeaders(UCase$(KEY_REQUEST))
    changesNumCol = changesHeaders(UCase$(KEY_NUMBER))

    lastChangeRow = LastUsedRow(wsChanges)
    lastChangeCol = LastUsedCol(wsChanges, CHANGES_HEADER_ROW)

    '---------------------------------------------------------------------------
    ' Process Changes from top to bottom.
    ' IMPORTANT: we never use the Changes row number as the Sheet1 row number.
    ' The Sheet1 row is located by REQUEST + NUMBER.
    '---------------------------------------------------------------------------
    For r = CHANGES_HEADER_ROW + 1 To lastChangeRow

        selectValue = NormalizeText(wsChanges.Cells(r, SELECT_COL).Value2)

        If selectValue <> "YES" Then
            skippedCount = skippedCount + 1
            GoTo ContinueRow
        End If

        selectedCount = selectedCount + 1

        action = NormalizeText(wsChanges.Cells(r, TYPE_COL).Value2)
        req = wsChanges.Cells(r, changesReqCol).Value2
        num = wsChanges.Cells(r, changesNumCol).Value2

        If Len(NormalizeKey(req)) = 0 And Len(NormalizeKey(num)) = 0 Then
            errorCount = errorCount + 1
            GoTo ContinueRow
        End If

        Select Case action

            Case "MODIFIED", "MODIFY"

                targetRow = FindUniqueRecord( _
                                wsTarget, _
                                targetReqCol, _
                                targetNumCol, _
                                req, _
                                num)

                If targetRow = 0 Then
                    errorCount = errorCount + 1
                ElseIf targetRow < 0 Then
                    'Duplicate REQUEST + NUMBER in Sheet1.
                    errorCount = errorCount + 1
                Else
                    'Replace the COMPLETE record using the Changes headers.
                    CopyDataByHeader _
                        wsChanges, r, _
                        wsTarget, targetRow, _
                        changesHeaders, targetHeaders

                    modifiedCount = modifiedCount + 1
                End If

            Case "ADDED", "ADD"

                targetRow = FindUniqueRecord( _
                                wsTarget, _
                                targetReqCol, _
                                targetNumCol, _
                                req, _
                                num)

                If targetRow <> 0 Then
                    'A positive row means it already exists.
                    'A negative row means duplicate records exist.
                    errorCount = errorCount + 1
                Else
                    targetRow = NextDataRow(wsTarget, TARGET_HEADER_ROW)

                    CopyDataByHeader _
                        wsChanges, r, _
                        wsTarget, targetRow, _
                        changesHeaders, targetHeaders

                    addedCount = addedCount + 1
                End If

            Case "DELETED", "DELETE"

                targetRow = FindUniqueRecord( _
                                wsTarget, _
                                targetReqCol, _
                                targetNumCol, _
                                req, _
                                num)

                If targetRow <= 0 Then
                    errorCount = errorCount + 1
                Else
                    wsTarget.Rows(targetRow).Delete
                    deletedCount = deletedCount + 1
                End If

            Case Else

                errorCount = errorCount + 1

        End Select

ContinueRow:
    Next r

    MsgBox _
        "DataUpdate completed." & vbCrLf & vbCrLf & _
        "Select = YES: " & selectedCount & vbCrLf & _
        "Modified: " & modifiedCount & vbCrLf & _
        "Added: " & addedCount & vbCrLf & _
        "Deleted: " & deletedCount & vbCrLf & _
        "Skipped (not YES): " & skippedCount & vbCrLf & _
        "Errors / not applied: " & errorCount, _
        vbInformation, "DataUpdate"

CleanExit:
    Application.ScreenUpdating = oldScreen
    Application.EnableEvents = oldEvents
    Application.DisplayAlerts = oldAlerts
    Application.Calculation = oldCalc
    Exit Sub

Fail:
    MsgBox _
        "DataUpdate stopped." & vbCrLf & vbCrLf & _
        "Error " & Err.Number & ": " & Err.Description, _
        vbCritical, "DataUpdate Error"
    Resume CleanExit

End Sub

'===============================================================================
' Copy the selected Changes row to the target row by HEADER NAME.
'
' This is deliberately NOT a simple C->A offset copy.
' It prevents wrong-column updates when the column order differs between
' Changes and Sheet1.
'
' Metadata columns (Changed By / Time / Date) are ignored automatically.
'===============================================================================
Private Sub CopyDataByHeader( _
    ByVal wsSource As Worksheet, _
    ByVal sourceRow As Long, _
    ByVal wsTarget As Worksheet, _
    ByVal targetRow As Long, _
    ByVal sourceHeaders As Object, _
    ByVal targetHeaders As Object)

    Dim key As Variant
    Dim sourceCol As Long
    Dim targetCol As Long
    Dim headerName As String

    For Each key In targetHeaders.Keys

        headerName = CStr(key)
        targetCol = CLng(targetHeaders(key))

        'Do not overwrite key columns from an unrelated metadata field.
        'REQUEST and NUMBER are still copied from the selected record.
        If sourceHeaders.Exists(headerName) Then

            sourceCol = CLng(sourceHeaders(headerName))

            If Not IsIgnoredHeader(headerName) Then
                wsTarget.Cells(targetRow, targetCol).Value2 = _
                    wsSource.Cells(sourceRow, sourceCol).Value2
            End If

        End If

    Next key

End Sub

'===============================================================================
' Find exactly one Sheet1 record by REQUEST + NUMBER.
'
' Returns:
'   0  = not found
'   >0 = exact target row
'   -1 = duplicate key exists
'===============================================================================
Private Function FindUniqueRecord( _
    ByVal ws As Worksheet, _
    ByVal requestCol As Long, _
    ByVal numberCol As Long, _
    ByVal requestValue As Variant, _
    ByVal numberValue As Variant) As Long

    Dim r As Long
    Dim lastRow As Long
    Dim foundRow As Long

    lastRow = LastUsedRow(ws)
    foundRow = 0

    For r = TARGET_HEADER_ROW + 1 To lastRow

        If StrComp( _
                NormalizeKey(ws.Cells(r, requestCol).Value2), _
                NormalizeKey(requestValue), _
                vbTextCompare) = 0 _
        And StrComp( _
                NormalizeKey(ws.Cells(r, numberCol).Value2), _
                NormalizeKey(numberValue), _
                vbTextCompare) = 0 Then

            If foundRow <> 0 Then
                FindUniqueRecord = -1
                Exit Function
            End If

            foundRow = r
        End If

    Next r

    FindUniqueRecord = foundRow

End Function

'===============================================================================
' Header map: uppercase trimmed header -> column number.
'===============================================================================
Private Function BuildHeaderMap( _
    ByVal ws As Worksheet, _
    ByVal headerRow As Long) As Object

    Dim dict As Object
    Dim lastCol As Long
    Dim c As Long
    Dim h As String

    Set dict = CreateObject("Scripting.Dictionary")
    dict.CompareMode = vbTextCompare

    lastCol = LastUsedCol(ws, headerRow)

    For c = 1 To lastCol

        h = NormalizeHeader(ws.Cells(headerRow, c).Value2)

        If Len(h) > 0 Then
            If Not dict.Exists(h) Then
                dict.Add h, c
            End If
        End If

    Next c

    Set BuildHeaderMap = dict

End Function

'===============================================================================
' Headers which must not be copied into Sheet1.
'===============================================================================
Private Function IsIgnoredHeader(ByVal headerName As String) As Boolean

    Select Case UCase$(Trim$(headerName))
        Case "CHANGED BY", "TIME", "DATE"
            IsIgnoredHeader = True
        Case Else
            IsIgnoredHeader = False
    End Select

End Function

'===============================================================================
' Normalize header text.
'===============================================================================
Private Function NormalizeHeader(ByVal v As Variant) As String

    If IsError(v) Or IsNull(v) Or IsEmpty(v) Then
        NormalizeHeader = ""
    Else
        NormalizeHeader = UCase$(Trim$(CStr(v)))
    End If

End Function

'===============================================================================
' Normalize ordinary text used for action/select.
'===============================================================================
Private Function NormalizeText(ByVal v As Variant) As String

    If IsError(v) Or IsNull(v) Or IsEmpty(v) Then
        NormalizeText = ""
    Else
        NormalizeText = UCase$(Trim$(CStr(v)))
    End If

End Function

'===============================================================================
' Normalize key values.
'
' Also removes non-breaking spaces, which can otherwise make visually identical
' REQUEST / NUMBER values fail to match.
'===============================================================================
Private Function NormalizeKey(ByVal v As Variant) As String

    Dim s As String

    If IsError(v) Or IsNull(v) Or IsEmpty(v) Then
        NormalizeKey = ""
        Exit Function
    End If

    s = CStr(v)
    s = Replace(s, ChrW(160), " ")
    s = Trim$(s)

    NormalizeKey = s

End Function

'===============================================================================
' Return the next data row in Sheet1.
'===============================================================================
Private Function NextDataRow(ByVal ws As Worksheet, ByVal headerRow As Long) As Long

    Dim lr As Long

    lr = LastUsedRow(ws)

    If lr <= headerRow Then
        NextDataRow = headerRow + 1
    Else
        NextDataRow = lr + 1
    End If

End Function

'===============================================================================
' Last used row anywhere in worksheet.
'===============================================================================
Private Function LastUsedRow(ByVal ws As Worksheet) As Long

    Dim f As Range

    Set f = ws.Cells.Find( _
                What:="*", _
                After:=ws.Cells(1, 1), _
                LookIn:=xlFormulas, _
                LookAt:=xlPart, _
                SearchOrder:=xlByRows, _
                SearchDirection:=xlPrevious, _
                MatchCase:=False)

    If f Is Nothing Then
        LastUsedRow = 1
    Else
        LastUsedRow = f.Row
    End If

End Function

'===============================================================================
' Last used column in a specified header row.
'===============================================================================
Private Function LastUsedCol( _
    ByVal ws As Worksheet, _
    ByVal headerRow As Long) As Long

    Dim f As Range

    Set f = ws.Rows(headerRow).Find( _
                What:="*", _
                After:=ws.Cells(headerRow, 1), _
                LookIn:=xlFormulas, _
                LookAt:=xlPart, _
                SearchOrder:=xlByColumns, _
                SearchDirection:=xlPrevious, _
                MatchCase:=False)

    If f Is Nothing Then
        LastUsedCol = 1
    Else
        LastUsedCol = f.Column
    End If

End Function
