Option Explicit
Private Const CHANGES_SHEET_NAME As String = "Changes"
Private Const TARGET_SHEET_INDEX As Long = 1
Private Const HEADER_ROW As Long = 2
Private Const SELECT_COL As Long = 1
Private Const TYPE_COL As Long = 2
Private Const DATA_START_COL As Long = 3

Public Sub Copy_Drawing_List()
    Dim wb As Workbook, ws As Worksheet, wc As Worksheet
    Dim lr As Long, lc As Long, r As Long, c As Long, tr As Long, dc As Long
    Dim reqT As Long, numT As Long, reqC As Long, numC As Long
    Dim selected As Long, nMod As Long, nAdd As Long, nDel As Long, skipped As Long, errors As Long
    Dim pick As String, action As String, hdr As String
    Dim req As Variant, num As Variant
    Dim oldCalc As XlCalculation, oldScreen As Boolean, oldEvents As Boolean, oldAlerts As Boolean

    On Error GoTo Fail
    oldScreen = Application.ScreenUpdating: oldEvents = Application.EnableEvents
    oldAlerts = Application.DisplayAlerts: oldCalc = Application.Calculation
    If MsgBox("Process only Changes rows with Select = YES?" & vbCrLf & vbCrLf & _
        "Modified = replace full record" & vbCrLf & "Added = append full record" & vbCrLf & _
        "Deleted = remove record", vbOKCancel + vbQuestion, "DataUpdate") <> vbOK Then Exit Sub

    Application.ScreenUpdating = False: Application.EnableEvents = False
    Application.DisplayAlerts = False: Application.Calculation = xlCalculationManual
    Set wb = ThisWorkbook: Set ws = wb.Worksheets(TARGET_SHEET_INDEX)
    Set wc = wb.Worksheets(CHANGES_SHEET_NAME)

    reqT = HeaderCol(ws, HEADER_ROW, "REQUEST"): numT = HeaderCol(ws, HEADER_ROW, "NUMBER")
    reqC = HeaderCol(wc, 1, "REQUEST"): numC = HeaderCol(wc, 1, "NUMBER")
    If reqT = 0 Or numT = 0 Or reqC = 0 Or numC = 0 Then Err.Raise vbObjectError + 100, , "REQUEST/NUMBER header missing."

    lr = LastRow(wc): lc = LastCol(wc, 1)
    For r = 2 To lr
        pick = UCase$(Trim$(SafeText(wc.Cells(r, SELECT_COL).Value2)))
        If pick <> "YES" Then skipped = skipped + 1: GoTo NextR
        selected = selected + 1
        action = UCase$(Trim$(SafeText(wc.Cells(r, TYPE_COL).Value2)))
        req = wc.Cells(r, reqC).Value2: num = wc.Cells(r, numC).Value2

        Select Case action
        Case "MODIFIED", "MODIFY"
            tr = FindRecord(ws, reqT, numT, req, num)
            If tr = 0 Then
                errors = errors + 1
            Else
                ' Full replacement: all mapped data columns are written, including intentional blanks.
                For c = DATA_START_COL To lc
                    hdr = Trim$(SafeText(wc.Cells(1, c).Value2))
                    If Len(hdr) > 0 And Not IsMetadata(hdr) Then
                        dc = HeaderCol(ws, HEADER_ROW, hdr)
                        If dc > 0 Then ws.Cells(tr, dc).Value2 = wc.Cells(r, c).Value2
                    End If
                Next c
                nMod = nMod + 1
            End If

        Case "ADDED", "ADD"
            If FindRecord(ws, reqT, numT, req, num) > 0 Then
                errors = errors + 1
            Else
                tr = LastRow(ws) + 1
                If tr <= HEADER_ROW Then tr = HEADER_ROW + 1
                For c = DATA_START_COL To lc
                    hdr = Trim$(SafeText(wc.Cells(1, c).Value2))
                    If Len(hdr) > 0 And Not IsMetadata(hdr) Then
                        dc = HeaderCol(ws, HEADER_ROW, hdr)
                        If dc > 0 Then ws.Cells(tr, dc).Value2 = wc.Cells(r, c).Value2
                    End If
                Next c
                nAdd = nAdd + 1
            End If

        Case "DELETED", "DELETE"
            tr = FindRecord(ws, reqT, numT, req, num)
            If tr = 0 Then
                errors = errors + 1
            Else
                ws.Rows(tr).Delete
                nDel = nDel + 1
            End If
        Case Else
            errors = errors + 1
        End Select
NextR:
    Next r

    MsgBox "Completed." & vbCrLf & "Selected YES: " & selected & vbCrLf & _
        "Modified: " & nMod & vbCrLf & "Added: " & nAdd & vbCrLf & _
        "Deleted: " & nDel & vbCrLf & "Skipped: " & skipped & vbCrLf & _
        "Errors/not applied: " & errors, vbInformation, "DataUpdate"
CleanExit:
    Application.ScreenUpdating = oldScreen: Application.EnableEvents = oldEvents
    Application.DisplayAlerts = oldAlerts: Application.Calculation = oldCalc
    Exit Sub
Fail:
    MsgBox "DataUpdate stopped: " & Err.Description, vbCritical, "DataUpdate Error"
    Resume CleanExit
End Sub

Private Function HeaderCol(ByVal ws As Worksheet, ByVal headerRow As Long, ByVal name As String) As Long
    Dim c As Long, lc As Long
    lc = LastCol(ws, headerRow)
    For c = 1 To lc
        If StrComp(Trim$(SafeText(ws.Cells(headerRow, c).Value2)), Trim$(name), vbTextCompare) = 0 Then
            HeaderCol = c: Exit Function
        End If
    Next c
End Function

Private Function FindRecord(ByVal ws As Worksheet, ByVal reqCol As Long, ByVal numCol As Long, _
                            ByVal reqValue As Variant, ByVal numValue As Variant) As Long
    Dim r As Long, lr As Long
    lr = LastRow(ws)
    For r = HEADER_ROW + 1 To lr
        If StrComp(NormalizeKey(ws.Cells(r, reqCol).Value2), NormalizeKey(reqValue), vbTextCompare) = 0 _
        And StrComp(NormalizeKey(ws.Cells(r, numCol).Value2), NormalizeKey(numValue), vbTextCompare) = 0 Then
            FindRecord = r: Exit Function
        End If
    Next r
End Function

Private Function NormalizeKey(ByVal v As Variant) As String
    If IsError(v) Or IsNull(v) Or IsEmpty(v) Then NormalizeKey = "" Else NormalizeKey = Trim$(CStr(v))
End Function
Private Function SafeText(ByVal v As Variant) As String
    If IsError(v) Or IsNull(v) Or IsEmpty(v) Then SafeText = "" Else SafeText = CStr(v)
End Function
Private Function IsMetadata(ByVal h As String) As Boolean
    IsMetadata = (StrComp(h, "Changed By", vbTextCompare) = 0 Or _
                  StrComp(h, "Time", vbTextCompare) = 0 Or _
                  StrComp(h, "Date", vbTextCompare) = 0)
End Function
Private Function LastRow(ByVal ws As Worksheet) As Long
    Dim f As Range
    Set f = ws.Cells.Find(What:="*", After:=ws.Cells(1, 1), LookIn:=xlFormulas, LookAt:=xlPart, _
        SearchOrder:=xlByRows, SearchDirection:=xlPrevious, MatchCase:=False)
    If f Is Nothing Then LastRow = 1 Else LastRow = f.Row
End Function
Private Function LastCol(ByVal ws As Worksheet, Optional ByVal headerRow As Long = 1) As Long
    Dim f As Range
    Set f = ws.Rows(headerRow).Find(What:="*", After:=ws.Cells(headerRow, 1), LookIn:=xlFormulas, _
        LookAt:=xlPart, SearchOrder:=xlByColumns, SearchDirection:=xlPrevious, MatchCase:=False)
    If f Is Nothing Then LastCol = 1 Else LastCol = f.Column
End Function